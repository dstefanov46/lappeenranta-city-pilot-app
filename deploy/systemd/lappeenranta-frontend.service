[Unit]
Description=Lappeenranta Next.js frontend
Requires=lappeenranta-backend.service
After=lappeenranta-backend.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lappeenranta
Group=lappeenranta
WorkingDirectory=/opt/lappeenranta
EnvironmentFile=/etc/lappeenranta/lappeenranta.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
